{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "pw-meded-faculty-calendar",
  "name": "PW MedEd Faculty Calendar",
  "short_name": "PW MedEd",
  "description": "Physics Wallah MedEd Faculty Schedule, Workload & Question Bank Portal",
  "start_url": "/login.html",
  "scope": "/",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone",
    "minimal-ui",
    "window-controls-overlay"
  ],
  "orientation": "any",
  "theme_color": "#2d4d37",
  "background_color": "#fbf9f5",
  "dir": "ltr",
  "lang": "en-US",
  "categories": [
    "education",
    "productivity",
    "medical"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Faculty Portal",
      "short_name": "Faculty",
      "description": "Access your personalized lecture schedule and calendar",
      "url": "/faculty.html",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Question Banks & PYQs",
      "short_name": "PYQs",
      "description": "Access verified chapter-wise NEET PG, INI-CET and FMGE question banks",
      "url": "/faculty.html#pyq",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Dean & Admin Dashboard",
      "short_name": "Admin",
      "description": "Access overall institute schedule overview and department workload",
      "url": "/admin.html",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
